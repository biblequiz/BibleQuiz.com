---
import { AppReleasePlatform, getAppReleaseManifest, type AppReleaseManifest } from "utils/AppReleases";
import FontAwesomeIcon from "./FontAwesomeIcon.tsx";

interface Props {
    /** Product name (the folder under `src/releases`). */
    product: string;

    /** Name of the app. */
    title: string;

    /** Who the app is for (e.g. Coach). */
    role: string;

    /** Short description of the app, shown under the name. */
    subtitle?: string;
}

const { product, title, role, subtitle } = Astro.props;

const platforms = [
    { key: "windows", platform: AppReleasePlatform.Windows, label: "Windows", icon: "fab faWindows" },
    { key: "android", platform: AppReleasePlatform.Android, label: "Android", icon: "fab faAndroid" },
    { key: "mac", platform: AppReleasePlatform.MacOS, label: "macOS", icon: "fab faApple" },
];

const rows = (await Promise.all(platforms.map(async (p) => ({
    ...p,
    manifest: await getAppReleaseManifest(product, p.platform),
})))).filter((r) => r.manifest).map((r, index) => {

    // Stable is the main download. The newest beta is a smaller link, unless there is no stable build.
    const manifest = r.manifest!;
    const main: AppReleaseManifest = manifest.stable ?? manifest.beta!;
    const beta = manifest.beta && manifest.beta.version !== main.version ? manifest.beta : null;
    return { ...r, index, main, beta };
});

const formatSize = (bytes: number) => `${Math.round(bytes / 1048576)} MB`;
const platformNames = rows.map((r) => r.label).join(" and ");
---

<article
    class="app-role"
    data-platforms={rows.map((r) => r.key).join(" ")}
    data-app-name={title}
    data-platform-names={platformNames}
>
    <p class="app-role__who">{role}</p>
    <h3 class="app-role__title">{title}{subtitle && <small>{subtitle}</small>}</h3>

    <div class="app-role__body"><slot /></div>

    {rows.length > 0 && (
        <div class="app-role__downloads">
            <div class="app-role__primary" hidden></div>
            <p class="app-role__unavailable" hidden></p>
            <details class="app-role__others" open>
                <summary>Downloads</summary>
                <div class="app-role__rows">
                    {rows.map((r) => (
                        <div class="app-role__row" data-platform={r.key} data-order={r.index}>
                            <span class="app-role__platform">
                                <FontAwesomeIcon icon={r.icon} />
                                {r.label}
                            </span>
                            <a
                                class="btn btn-primary app-role__button"
                                href={r.main.downloadUrl}
                                rel="noopener noreferrer"
                                download
                            >
                                <span>Download<span class="app-role__for"> for {r.label}</span></span>{" "}
                                <span class="font-bold">v{r.main.version}</span>{" "}
                                <span class:list={["badge badge-soft", r.main.isBeta ? "badge-warning" : "badge-primary"]}>
                                    {r.main.isBeta ? "BETA" : "STABLE"}
                                </span>{" "}
                                <span class="app-role__size">{formatSize(r.main.size)}</span>
                            </a>
                            {r.beta && (
                                <span class="app-role__beta">
                                    or try the <a href={r.beta.downloadUrl} rel="noopener noreferrer" download>beta v{r.beta.version}</a>{" "}
                                    ({formatSize(r.beta.size)})
                                </span>
                            )}
                        </div>
                    ))}
                </div>
            </details>
        </div>
    )}

    <div class="app-role__extra"><slot name="extra" /></div>
</article>

<style>
    .app-role {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.25rem;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.75rem;
        background: var(--sl-color-black);
        min-width: 0;
    }

    .app-role__who {
        margin: 0;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--sl-color-gray-3);
    }

    .app-role__title {
        margin: 0;
        font-size: 1.4rem;
        line-height: 1.15;
    }

    .app-role__title small {
        display: block;
        margin-top: 0.15rem;
        font-size: 0.9rem;
        font-weight: 400;
        color: var(--sl-color-gray-3);
    }

    .app-role__body > :first-child,
    .app-role__extra > :first-child {
        margin-top: 0;
    }

    .app-role__downloads {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .app-role__rows {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding-top: 0.5rem;
    }

    .app-role__row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem 0.75rem;
    }

    .app-role__platform {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        min-width: 6.5rem;
        font-weight: 600;
    }

    /* DaisyUI buttons are one fixed-height line, which clips a long label on a narrow card. */
    .app-role__button {
        flex-wrap: wrap;
        justify-content: flex-start;
        height: auto;
        min-height: 2.5rem;
        max-width: 100%;
        padding-block: 0.4rem;
        gap: 0.25rem 0.6rem;
        text-align: left;
        white-space: normal;
    }

    .app-role__size {
        font-weight: 400;
        font-size: 0.85rem;
    }

    .app-role__for {
        display: none;
    }

    .app-role__beta {
        font-size: 0.85rem;
        color: var(--sl-color-gray-3);
    }

    .app-role__beta a {
        color: inherit;
    }

    summary {
        cursor: pointer;
        font-size: 0.9rem;
        color: var(--sl-color-gray-2);
    }

    .app-role__unavailable {
        margin: 0;
        color: var(--sl-color-gray-2);
    }

    /* The detected platform is moved here by the script on AppPicker. */
    .app-role__primary {
        flex-direction: column;
        gap: 0.4rem;
    }

    .app-role__primary:not([hidden]) {
        display: flex;
    }

    .app-role__primary :global(.app-role__row) {
        flex-direction: column;
        align-items: flex-start;
    }

    .app-role__primary :global(.app-role__platform) {
        display: none;
    }

    .app-role__primary :global(.app-role__for) {
        display: inline;
    }

    .app-role__primary :global(.app-role__button) {
        min-height: 3.25rem;
        padding-inline: 1.5rem;
        font-size: 1.05rem;
    }
</style>
