---
import config from "virtual:starlight/user-config";

// @ts-ignore
import Search from "virtual:starlight/components/Search";
// @ts-ignore
import SiteTitle from "virtual:starlight/components/SiteTitle";
import AuthButton, { AuthButtonType } from "./auth/AuthButton";
import GlobalNotificationManager from "./GlobalNotificationManager.astro";
import FontAwesomeIcon from "./FontAwesomeIcon";
import { TASKS, getTaskForPath } from "utils/Tasks";

/**
 * Render the `Search` component if Pagefind is enabled or the default search component has been overridden.
 */
const shouldRenderSearch =
    config.pagefind ||
    config.components.Search !== "@astrojs/starlight/components/Search.astro";

const currentTask = getTaskForPath(Astro.url.pathname);
const headerTasks = TASKS.filter((t) => !t.isAdmin);
---

<GlobalNotificationManager />

<div class="bq-header">
    <div class="title-wrapper sl-flex">
        <SiteTitle />
    </div>

    <nav class="bq-task-links print:hidden" aria-label="Tasks">
        {
            headerTasks.map((task) => (
                <a
                    href={task.href}
                    class="bq-task-link"
                    aria-current={currentTask?.id === task.id ? "page" : undefined}
                >
                    {task.shortLabel}
                </a>
            ))
        }
    </nav>

    <div class="bq-header-actions print:hidden">
        {shouldRenderSearch && <Search />}
        <AuthButton type={AuthButtonType.Header} client:only="react" />
        <button type="button" class="bq-menu-button" data-bq-open-menu aria-haspopup="dialog" aria-controls="bq-menu-dialog">
            <FontAwesomeIcon icon="fas faBars" />
            <span>Menu</span>
        </button>
    </div>
</div>

<style>
    @layer starlight.core {
        .bq-header {
            display: flex;
            gap: 0.5rem;
            align-items: center;
            height: 100%;
        }

        .title-wrapper {
            /* Prevent the logo from covering the buttons on narrow viewports. */
            overflow: clip;
            /* Avoid clipping the focus ring around the link inside the title wrapper. */
            padding: 0.25rem;
            margin: -0.25rem;
            min-width: 0;
            flex: none;
            margin-inline-end: 0.75rem;
        }

        .bq-task-links {
            display: none;
            gap: 0.125rem;
            min-width: 0;
        }

        .bq-task-link {
            color: #fff;
            font-size: 0.9375rem;
            font-weight: 600;
            text-decoration: none;
            padding: 0.5rem 0.625rem;
            border-radius: 0.5rem;
            white-space: nowrap;
        }

        .bq-task-link:hover {
            background: rgba(255, 255, 255, 0.12);
        }

        .bq-task-link[aria-current="page"] {
            background: rgba(255, 255, 255, 0.18);
            box-shadow: inset 0 -3px 0 #fff;
        }

        .bq-header-actions {
            display: flex;
            gap: 0.5rem;
            align-items: center;
            margin-inline-start: auto;
        }

        .bq-menu-button {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            height: 2.5rem;
            padding: 0 0.75rem;
            border-radius: 0.625rem;
            border: 1px solid rgba(255, 255, 255, 0.4);
            background: transparent;
            color: #fff;
            font: inherit;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
        }

        .bq-menu-button:hover {
            background: rgba(255, 255, 255, 0.12);
        }

        /* The Task links fit from this width; narrower screens use the Menu instead (D11). */
        @media (min-width: 76rem) {
            .bq-task-links {
                display: flex;
            }

            .bq-menu-button {
                display: none;
            }
        }
    }
</style>
