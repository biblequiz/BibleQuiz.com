---
import FontAwesomeIcon from "./FontAwesomeIcon";
import { TASKS, getTaskForPath } from "utils/Tasks";

/**
 * The Menu (D11): a full-screen list of every Task, opened by any button with the
 * `data-bq-open-menu` attribute (the header's Menu button). It is rendered by PageFrame rather than
 * the header, because the header forces its own colors on everything inside it.
 */

const currentTask = getTaskForPath(Astro.url.pathname);
const isOnHub = currentTask !== null && Astro.url.pathname === currentTask.href;
---

<bq-site-menu class="bq-menu-root">
    <dialog id="bq-menu-dialog" class="bq-menu-dialog" aria-labelledby="bq-menu-title">
        <div class="bq-menu-top">
            <h2 id="bq-menu-title">Menu</h2>
            <button type="button" class="bq-menu-close" data-close>
                <FontAwesomeIcon icon="fas faXmark" />
                <span>Close</span>
            </button>
        </div>

        <div class="bq-menu-body">
            {
                currentTask && !isOnHub && (
                    <a class="bq-menu-back" href={currentTask.href}>
                        <FontAwesomeIcon icon="fas faArrowLeft" />
                        Back to {currentTask.label}
                    </a>
                )
            }

            <p class="bq-menu-heading">What do you want to do?</p>
            <ul class="bq-menu-list">
                {
                    TASKS.map((task) => (
                        <li>
                            <a
                                class={`bq-menu-row ${task.isAdmin ? "bq-menu-row-admin" : ""}`}
                                href={task.href}
                                aria-current={currentTask?.id === task.id ? "page" : undefined}
                            >
                                <span class="bq-menu-chip">
                                    <FontAwesomeIcon icon={task.icon} />
                                </span>
                                <span class="bq-menu-text">
                                    <span class="bq-menu-label">{task.label}</span>
                                    <span class="bq-menu-desc">{task.description}</span>
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>

            <p class="bq-menu-footer">
                <a href="/">Home</a> · <a href="/terms/">Terms</a> · <a href="/privacy/">Privacy</a>
            </p>
        </div>
    </dialog>
</bq-site-menu>

<script>
    class BqSiteMenu extends HTMLElement {
        connectedCallback() {
            const dialog = this.querySelector("dialog") as HTMLDialogElement;
            let opener: HTMLElement | null = null;

            document.querySelectorAll<HTMLElement>("[data-bq-open-menu]").forEach((button) =>
                button.addEventListener("click", () => {
                    opener = button;
                    dialog.showModal();
                }),
            );

            dialog.addEventListener("close", () => opener?.focus());

            dialog.querySelectorAll("[data-close]").forEach((button) =>
                button.addEventListener("click", () => dialog.close()),
            );

            // Clicking the dimmed area outside the panel closes it.
            dialog.addEventListener("click", (e) => {
                if (e.target === dialog) {
                    dialog.close();
                }
            });
        }
    }

    customElements.define("bq-site-menu", BqSiteMenu);
</script>

<style>
    @layer starlight.core {
        .bq-menu-root {
            display: contents;
        }

        .bq-menu-close {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.375rem;
            height: 2.5rem;
            padding: 0 0.75rem;
            border-radius: 0.625rem;
            font: inherit;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
        }

        .bq-menu-close {
            border: 1px solid var(--sl-color-gray-5);
            background: transparent;
            color: var(--sl-color-white);
        }

        .bq-menu-dialog {
            /* Full screen on phones; a side panel on wider screens. */
            margin: 0;
            margin-inline-start: auto;
            width: 100%;
            max-width: 100%;
            height: 100%;
            max-height: 100%;
            padding: 0;
            border: 0;
            background: var(--sl-color-bg);
            color: var(--sl-color-white);
        }

        .bq-menu-dialog::backdrop {
            background: rgba(10, 30, 30, 0.45);
        }

        .bq-menu-top {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--sl-color-hairline);
        }

        .bq-menu-top h2 {
            flex: 1;
            margin: 0;
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--sl-color-white);
        }

        .bq-menu-body {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            padding: 1rem;
        }

        .bq-menu-back {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            min-height: 3rem;
            padding: 0 0.875rem;
            border-radius: 0.75rem;
            background: var(--sl-color-accent-low);
            color: var(--sl-color-white);
            font-weight: 700;
            text-decoration: none;
        }

        .bq-menu-heading {
            margin: 0.25rem 0 0;
            font-size: 0.8125rem;
            font-weight: 700;
            color: var(--sl-color-gray-3);
        }

        .bq-menu-list {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .bq-menu-row {
            display: flex;
            align-items: center;
            gap: 0.875rem;
            min-height: 3.75rem;
            padding: 0.375rem 0.25rem;
            border-bottom: 1px solid var(--sl-color-hairline);
            color: var(--sl-color-white);
            text-decoration: none;
        }

        .bq-menu-row[aria-current="page"] .bq-menu-label {
            color: var(--sl-color-text-accent);
        }

        .bq-menu-chip {
            display: flex;
            align-items: center;
            justify-content: center;
            flex: none;
            width: 2.375rem;
            height: 2.375rem;
            border-radius: 0.75rem;
            background: var(--sl-color-accent-low);
            color: var(--sl-color-text-accent);
        }

        .bq-menu-row-admin .bq-menu-chip {
            background: var(--sl-color-gray-6);
            color: var(--sl-color-gray-3);
        }

        .bq-menu-text {
            display: flex;
            flex-direction: column;
            gap: 0.125rem;
        }

        .bq-menu-label {
            font-size: 1rem;
            font-weight: 700;
            line-height: 1.3;
        }

        .bq-menu-desc {
            font-size: 0.8125rem;
            color: var(--sl-color-gray-3);
        }

        .bq-menu-footer {
            margin: 0.5rem 0 0;
            text-align: center;
            font-size: 0.8125rem;
            color: var(--sl-color-gray-3);
        }

        @media (min-width: 40rem) {
            .bq-menu-dialog {
                width: 26.25rem;
                box-shadow: -12px 0 32px rgba(0, 30, 30, 0.18);
            }
        }
    }
</style>
