---
// A quick download at the top of the apps page for visitors on a platform that has exactly one app
// (Android and macOS today). Everyone else sees the page as it always was. The page is built with
// the banners hidden, and the script reveals the one that matches the visitor's device.
import { AppReleasePlatform, getAppReleaseManifest, type AppReleaseManifest } from "utils/AppReleases";

const apps = [
    { product: "CoachApp", name: "Coaching App" },
    { product: "EZScore", name: "EZScore" },
    { product: "ScoreKeep", name: "ScoreKeep" },
];

const devices = [
    { device: "android", platform: AppReleasePlatform.Android, label: "Android" },
    { device: "mac", platform: AppReleasePlatform.MacOS, label: "macOS" },
];

const formatSize = (bytes: number) => `${Math.round(bytes / 1048576)} MB`;

const quick = (await Promise.all(devices.map(async (d) => {

    const available = (await Promise.all(apps.map(async (a) => ({
        ...a,
        manifest: await getAppReleaseManifest(a.product, d.platform),
    })))).filter((a) => a.manifest);

    // With several apps on a platform, the visitor still has to choose, so there is no quick download.
    if (available.length !== 1) {
        return null;
    }

    const app = available[0];
    const manifest = app.manifest!;
    const main: AppReleaseManifest = manifest.stable ?? manifest.beta!;
    const beta = manifest.beta && manifest.beta.version !== main.version ? manifest.beta : null;
    const missing = apps.filter((a) => a.product !== app.product).map((a) => a.name);
    return { ...d, app, main, beta, missing };
}))).filter((q) => q !== null);
---

{quick.map((q) => (
    <aside class="quick-download not-content" data-quick-device={q.device} hidden>
        <p class="quick-download__title">{q.app.name} for {q.label}</p>
        <div class="quick-download__actions">
            <a class="btn btn-primary" href={q.main.downloadUrl} rel="noopener noreferrer" download>
                Download <span class="font-bold">v{q.main.version}</span>
                <span class:list={["badge badge-soft", q.main.isBeta ? "badge-warning" : "badge-primary"]}>
                    {q.main.isBeta ? "BETA" : "STABLE"}
                </span>
                <span class="quick-download__size">{formatSize(q.main.size)}</span>
            </a>
            {q.beta && (
                <span class="quick-download__beta">
                    or try the <a href={q.beta.downloadUrl} rel="noopener noreferrer" download>beta v{q.beta.version}</a>{" "}
                    ({formatSize(q.beta.size)})
                </span>
            )}
        </div>
        <p class="quick-download__note">
            {q.missing.join(" and ")} {q.missing.length === 1 ? "is" : "are"} not available for {q.label}.
            Every download is listed below.
        </p>
    </aside>
))}

<script>
    import { detectDevice } from "utils/DetectDevice";

    // Highlight the visitor's platform on the cards below (see the style block), and show the banner.
    const device = detectDevice();
    const banner = document.querySelector<HTMLElement>(`[data-quick-device="${device}"]`);
    if (banner) {
        banner.hidden = false;
        document.documentElement.dataset.appDevice = device === "mac" ? "macos" : device;
    }
</script>

<style>
    .quick-download {
        flex-direction: column;
        gap: 0.6rem;
        margin-bottom: 1.5rem;
        padding: 1.1rem 1.25rem;
        border: 2px solid var(--sl-color-accent);
        border-radius: 0.75rem;
        background: var(--sl-color-accent-low);
    }

    .quick-download:not([hidden]) {
        display: flex;
    }

    .quick-download__title {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 600;
        line-height: 1.2;
        color: var(--sl-color-white);
    }

    .quick-download__actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 1rem;
    }

    .quick-download__size {
        font-size: 0.85rem;
        font-weight: 400;
    }

    .quick-download__beta,
    .quick-download__note {
        margin: 0;
        font-size: 0.85rem;
        color: var(--sl-color-gray-2);
    }

    .quick-download__beta a {
        color: inherit;
    }
</style>

<style is:global>
    /* The visitor's platform stands out on the cards below, and the others fade back. */
    html[data-app-device="android"] [data-app-platform]:not([data-app-platform="android"]),
    html[data-app-device="macos"] [data-app-platform]:not([data-app-platform="macos"]) {
        opacity: 0.55;
    }

    html[data-app-device="android"] [data-app-platform="android"],
    html[data-app-device="macos"] [data-app-platform="macos"] {
        outline: 2px solid var(--sl-color-accent);
    }
</style>
