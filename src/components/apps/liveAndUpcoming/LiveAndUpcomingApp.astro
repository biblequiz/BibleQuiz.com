---
import LiveAndUpcomingRoot from "./LiveAndUpcomingRoot";

import regions from "data/regions.json";
import districts from "data/districts.json";

import { getLiveAndUpcomingData } from "utils/LiveEvents";

const { currentSeason, currentSeasonLinks, recentSeasonEvents, futureEvents } =
    await getLiveAndUpcomingData(import.meta.url);
---

<div id="generator-fallback" class="flex justify-center items-center">
    <span class="loading loading-spinner loading-xl"></span>&nbsp; Loading the
    Live and Upcoming Events ...
</div>
<LiveAndUpcomingRoot
    client:only="react"
    regions={regions}
    districts={districts}
    recentSeasonEvents={recentSeasonEvents}
    currentSeason={currentSeason}
    currentSeasonLinks={currentSeasonLinks}
    futureEvents={futureEvents}
    loadingElementId="generator-fallback"
/>
