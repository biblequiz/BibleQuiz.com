---
// @ts-nocheck
import Pagination from "virtual:starlight/components/Pagination";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import SocialIcons from "./SocialIcons.astro";

const {
    hideFooterOnPrint,
    hideAdsOnPrint,
} = Astro.locals.starlightRoute.entry.data;
---

<footer class={`sl-flex ${hideFooterOnPrint ? "hide-on-print": ""}`}>
    <Pagination />

    <div class={`grid grid-cols-2 lg:flex lg:justify-center gap-4 ${hideAdsOnPrint ? "hide-on-print" : ""}`}>
        <div class="flex justify-center">
            <a href="https://www.evangel.edu/">
                <img
                    src="/assets/sponsors/evangel.jpg"
                    alt="Evangel University"
                    class="max-h-20 w-auto object-contain"
                />
            </a>
        </div>
        <div class="flex justify-center">
            <a href="https://globaluniversity.edu/">
                <img
                    src="/assets/sponsors/global.jpg"
                    alt="Global University"
                    class="max-h-20 w-auto object-contain"
                />
            </a>
        </div>
        <div class="flex justify-center">
            <a href="/assets/sponsors/Lindenwood-University.pdf">
                <img
                    src="/assets/sponsors/lindenwood.jpg"
                    alt="Lindenwood University"
                    class="max-h-20 w-auto object-contain"
                />
            </a>
        </div>
    </div>

    <nav class="bq-footer-links hide-on-print" aria-label="Site">
        <a href="/">Home</a>
        <a href="/terms/">Terms &amp; Conditions</a>
        <a href="/privacy/">Privacy Policy</a>
        <SocialIcons />
        <ThemeSelect />
    </nav>

    <div style={{ textAlign: "center" }}>
        <i>
            Junior Bible Quiz graphics, logos, product images, and service names
            are trademarked by the General Council of the Assemblies of God. Use
            of these images and trademarks without written authorization is
            forbidden and is a violation of federal and international laws.
        </i>
    </div>
</footer>

<style>
    @layer starlight.core {
        footer {
            flex-direction: column;
            gap: 1.5rem;
        }
        .meta {
            gap: 0.75rem 3rem;
            justify-content: space-between;
            flex-wrap: wrap;
            margin-top: 3rem;
            font-size: var(--sl-text-sm);
            color: var(--sl-color-gray-3);
        }
        .meta > :global(p:only-child) {
            margin-inline-start: auto;
        }
    }

    @layer starlight.components {
        .kudos :global(svg) {
            color: var(--sl-color-orange);
        }
    }

    .bq-footer-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 0.5rem 1.25rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--sl-color-hairline);
        font-size: var(--sl-text-sm);
    }

    img {
        max-width: 100%;
        max-height: 100%;
    }
</style>
