---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
// @ts-ignore
import type { StarlightPageFrontmatter } from "@astrojs/starlight/types";
import { getAllGeneratedEvents } from "utils/Events";
import EventRoot from "components/apps/event/EventRoot";
import RoomDialog from "components/scores/RoomDialog.astro";

const archiveVersions = Object.fromEntries(
    (await getAllGeneratedEvents(import.meta.url)).map(e => [e.event.id, e.event.archiveVersion ?? null]));

const frontmatter: StarlightPageFrontmatter = {
    title: "Manage My Event",
    hidePageTitle: true,
    hideAdsOnPrint: true,
    pagefind: false
};
---

<StarlightPage frontmatter={frontmatter}>
    <div id="event-fallback" class="flex justify-center items-center">
        <span class="loading loading-spinner loading-xl"></span>&nbsp; Loading Page ...
    </div>
    <EventRoot client:only="react" archiveVersions={archiveVersions} />
    <RoomDialog />
</StarlightPage>
