---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
// @ts-ignore
import type { StarlightPageFrontmatter } from "@astrojs/starlight/types";

import FontAwesomeIcon from "components/FontAwesomeIcon";
import HappeningNow from "components/apps/liveAndUpcoming/HappeningNow";
import { getLiveAndUpcomingData } from "utils/LiveEvents";
import { TASKS } from "utils/Tasks";

/**
 * The Task Chooser (D3): asks what the visitor is trying to do. Everything must fit one phone
 * screen without scrolling (D5).
 */

const frontmatter: StarlightPageFrontmatter = {
    title: "What are you trying to do?",
    description: "Home of AG Bible Quiz: live scores, past results, apps, rules, study material and news for Junior Bible Quiz and Teen Bible Quiz.",
    template: "doc",
    hidePageTitle: true,
    tableOfContents: false,
    pagefind: false,
};

const { recentSeasonEvents, futureEvents } = await getLiveAndUpcomingData(import.meta.url);

const publicTasks = TASKS.filter((t) => !t.isAdmin);
const adminTask = TASKS.find((t) => t.isAdmin)!;
---

<StarlightPage frontmatter={frontmatter}>
    <script is:inline>
        // The Event List used to be the home page (/?type=jbq). Send those links to its new page (D3).
        if (new URLSearchParams(window.location.search).has("type")) {
            window.location.replace("/events/" + window.location.search + window.location.hash);
        }
    </script>

    <div class="not-content bq-wide bq-home">
        <div>
            <h1>What are you trying to do?</h1>
            <p class="bq-home-sub">Choose one to get started.</p>
        </div>

        <HappeningNow
            client:only="react"
            futureEvents={futureEvents}
            recentSeasonEvents={recentSeasonEvents}
        />

        <div class="bq-tiles">
            {
                publicTasks.map((task) => (
                    <a class="bq-tile" href={task.href}>
                        <span class="bq-chip">
                            <FontAwesomeIcon icon={task.icon} />
                        </span>
                        <span class="bq-tile-label">{task.label}</span>
                        <span class="bq-tile-desc">{task.description}</span>
                    </a>
                ))
            }
        </div>

        <a class="bq-admin-row" href={adminTask.href}>
            <FontAwesomeIcon icon={adminTask.icon} />
            <span class="bq-card-text" style="flex: 1">
                <span class="bq-tile-label">{adminTask.label}</span>
                <span class="bq-tile-desc">{adminTask.description}</span>
            </span>
            <FontAwesomeIcon icon="fas faChevronRight" />
        </a>
    </div>
</StarlightPage>
